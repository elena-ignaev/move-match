# Copy to .env and adjust. Flask loads .env automatically (python-dotenv) when you use `flask ...`.
FLASK_APP=app.py

# development | production. production requires SECRET_KEY and forces secure cookies.
MOVEMATCH_ENV=development
MOVEMATCH_DEBUG=0

# Required in production/public-demo mode: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# SQLite file by default. Create/upgrade the schema with: flask db upgrade
# DATABASE_URL=sqlite:////absolute/path/to/videos.sqlite3

# Where uploads, recordings and landmark files are stored.
# MOVEMATCH_STORAGE_DIR=./storage

# Pose model (download with: python scripts/download_model.py)
# MOVEMATCH_MODEL_PATH=./pretrained_models/pose_landmarker_lite.task

# Limits for reference videos and practice recordings
MOVEMATCH_MAX_REFERENCE_MB=200
MOVEMATCH_MAX_REFERENCE_SECONDS=90
MOVEMATCH_MAX_ATTEMPT_MB=150
MOVEMATCH_MAX_ATTEMPT_SECONDS=240
MOVEMATCH_MAX_SOURCE_DIMENSION=1920

# Public demo mode: visitors see only sample videos and their own attempts; attempts are deleted
# after MOVEMATCH_RETENTION_HOURS. Reference uploads are off unless explicitly allowed.
MOVEMATCH_PUBLIC_DEMO=0
# MOVEMATCH_ALLOW_REFERENCE_UPLOADS=0
# MOVEMATCH_RETENTION_HOURS=24
# MOVEMATCH_ATTEMPT_UPLOADS_PER_HOUR=20

# Developer landmark inspector at /dev/landmarks/ (never enable on a public server)
ENABLE_DEV_TOOLS=0
